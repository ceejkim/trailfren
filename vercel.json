{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/cameras/provider-adapters", "destination": "/api/cameras/adapters?adapterPath=provider-adapters" },
    { "source": "/api/cameras/ring/:path*", "destination": "/api/cameras/adapters?adapterPath=ring/:path*" },
    { "source": "/api/cameras/nest/:path*", "destination": "/api/cameras/adapters?adapterPath=nest/:path*" },
    { "source": "/api/cameras/birdfy/partner-request", "destination": "/api/cameras/adapters?adapterPath=birdfy/partner-request" },
    { "source": "/api/cameras/bird-buddy/partner-request", "destination": "/api/cameras/adapters?adapterPath=bird-buddy/partner-request" },
    { "source": "/api/cameras/wyze/model-check", "destination": "/api/cameras/adapters?adapterPath=wyze/model-check" },
    { "source": "/api/cameras/relay-manifests", "destination": "/api/cameras/adapters?adapterPath=relay-manifests" }
  ]
}
