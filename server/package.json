{
  "name": "server",
  "version": "1.0.22",
  "description": "Trailfren server",
  "proxy": "http://localhost:3010",
  "scripts": {
    "build": "esbuild src/index.ts --platform=node --bundle --outfile=dist/index.js",
    "build-sdk": "node build_sdk.js && tsc src/sdk.ts --declaration --emitDeclarationOnly --outDir sdk && cp sdk/sdk.d.ts sdk/index.d.ts",
    "copy-sdk-to-client": "rm -rf \"../client/src/sdk\" && cp -r \"./sdk\" \"../client/src/sdk\" && rm -r sdk",
    "build-client": "npm version patch && cd ../client && npm version patch && npm run build && cd ../server",
    "start": "npm run build-sdk && npm run copy-sdk-to-client && vite-node src/index.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/body-parser": "^1.19.2",
    "axios": "1.3.5",
    "body-parser": "^1.20.2",
    "connect-timeout": "^1.9.0",
    "cors": "^2.8.5",
    "esbuild": "^0.17.15",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "lodash": "^4.17.21",
    "stripe": "^12.0.0",
    "vite-node": "^0.29.8",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "4.17.17",
    "@types/lodash": "^4.14.192",
    "@types/node": "^18.15.11",
    "esbuild-config": "^1.0.1",
    "netlify-lambda": "^2.0.16",
    "serverless-http": "^3.2.0",
    "typescript": "^5.0.4"
  }
}
